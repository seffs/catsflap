# catsflap — pubkey stack. Copy to .env and fill in. Loaded by `docker compose`.

# tailcat client public key allowed to reach the bastion (the device gate). On
# the machine you connect FROM: `tailcat genkey --client --key=client-default`
# and paste the nodekey it prints here.
ALLOW_KEY=nodekey:REPLACE_ME

# step-ca password: initializes and unlocks the CA, and lets the bastion mint
# certificates. It stays server-side — clients authenticate with their SSH key
# and never see this.
CA_PASSWORD=REPLACE_ME

# The target host the bastion logs in to (its real sshd). The default reaches
# the Docker host; set it to any host reachable from the bastion container.
TARGET_HOST=host.docker.internal

# --- optional (sensible defaults) ---
#CA_URL=https://step-ca:9000     # step-ca as seen from the bastion
#JWK_PROVISIONER=admin           # the provisioner auto-init creates
#SSHD_PORT=22                    # bastion front-door port (also the tailcat serve port)

# Who may connect, and as whom, lives in ./keymap (key -> principal), not here.
