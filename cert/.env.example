# Copy to .env and fill in. Loaded automatically by `docker compose` and, if
# present, sourced by ./quickstart.sh. Every configurable value lives here.

# ── docker-compose.yml (the real deployment) ──────────────────────────────────

# tailcat client public key allowed to reach the bastion. On the machine you
# connect FROM, run `tailcat genkey --client --key=client-default` and paste the
# nodekey it prints here (re-print later with `tailcat printpub`).
ALLOW_KEY=nodekey:REPLACE_ME

# Password for step-ca. It initializes the CA on first `up` and unlocks it on
# every start. It's also the password you type at the JWK "unlock CA" prompt.
CA_PASSWORD=REPLACE_ME

# Default target as user@host. The client can override the user
# (`tailcat ssh <addr> alice`); a bare `tailcat ssh <addr>` prompts for it.
TARGET=me@localhost

# Which method a connection uses by default: jwk (the CA password, prompted —
# works out of the box) or oidc (a person logs in through your IdP; add a
# provisioner first, see QUICKSTART step 4). Override per connection with --oidc/--jwk.
DEFAULT_METHOD=jwk

# ── optional (sensible defaults) ──────────────────────────────────────────────

# step-ca URL as seen from the host-networked bastion. Default matches the
# published loopback port.
#CA_URL=https://localhost:9000

# Provisioner names. OIDC_PROVISIONER is the name you gave `step ca provisioner
# add`; JWK_PROVISIONER defaults to "admin" (the one auto-init creates).
#OIDC_PROVISIONER=oidc
#JWK_PROVISIONER=admin

# Pin the CA fingerprint instead of deriving it from the shared volume (rarely needed).
#CA_FINGERPRINT=

# JWK without a prompt (automation): the provisioner password as a value, and the
# fixed principals to bake into the cert (which accounts a connection may become).
#PROVISIONER_PASSWORD=
#CERT_PRINCIPALS=

# Your own DERP relay (see README "Bring your own DERP"). Empty = nearest public
# Tailscale DERP. Baked into the server key, so set it before first `up`; changing
# it later means regenerating the key (drop the tailcat-key volume — see README).
# Comma-separate for multiple relays.
#DERP_HOST=derp.example.com

# ── quickstart.sh OIDC mode ───────────────────────────────────────────────────
# Set these to run the self-contained quickstart against your IdP instead of JWK
# certs (see QUICKSTART.md). Unset = JWK mode.

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
